# All optional. With none set, everything runs on MOCKS (MOCK_MODE=auto).
MOCK_MODE=auto            # auto | true | false
DRY_RUN=true              # real connectors only: log instead of write
DEMO_TONIGHT=2026-12-06T21:00:00-08:00
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SLACK_TOKEN=
NOTION_TOKEN=
GITHUB_TOKEN=
LINEAR_API_KEY=
ANTHROPIC_API_KEY=
SIE_URL=http://localhost:8080   # local fallback
SIE_GEN_MODEL=Qwen/Qwen3.5-4B       # hosted generation (planner summary, triage escalation, SRE explanations)
SIE_MIN_CREDITS=50000               # stop using hosted below this balance
OVERNIGHT_OFFLINE=0                 # 1 = force all mocks (tests)
SIE_API_KEY=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
ARCEE_API_KEY=
FIREDRILL_API_KEY=
# Cognee embeddings (Phase 2): hosted SIE has no MiniLM -> EMBEDDING_MODEL=BAAI/bge-m3 EMBEDDING_DIMENSIONS=1024 via https://api.superlinked.com/v1

# Demo emails (scripts/send_demo_emails.py): the ONLY address demo messages may be sent to. Leave empty to disable sending.
DEMO_RECIPIENT=
ALLOW_HOSTED_FOR_REAL_DATA=0   # keep 0: real email never goes to hosted Superlinked
DRY_RUN=true                   # keep true: every write is simulated
REAL_CLOCK=0
SOURCES_MOCK=0
DEMO_SELF_SEND=true   # demo mode: self-sent demo mail uses Reply-To/display name as the sender

# Cognee Cloud (optional): set BOTH to use the cloud instead of the local engine
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
