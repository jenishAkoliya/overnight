# All optional. With none set, everything runs on MOCKS (MOCK_MODE=auto).
MOCK_MODE=auto            # auto | true | false
DRY_RUN=true              # real connectors only: log instead of write
DEMO_TONIGHT=2026-12-06T21:00:00-08:00
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SLACK_TOKEN=
NOTION_TOKEN=
GITHUB_TOKEN=
LINEAR_API_KEY=
ANTHROPIC_API_KEY=
SIE_URL=http://localhost:8080   # local fallback
SIE_GEN_MODEL=Qwen/Qwen3.5-4B       # hosted generation (planner summary, triage escalation, SRE explanations)
SIE_MIN_CREDITS=50000               # stop using hosted below this balance
OVERNIGHT_OFFLINE=0                 # 1 = force all mocks (tests)
SIE_API_KEY=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
ARCEE_API_KEY=
FIREDRILL_API_KEY=
# Cognee embeddings (Phase 2): hosted SIE has no MiniLM -> EMBEDDING_MODEL=BAAI/bge-m3 EMBEDDING_DIMENSIONS=1024 via https://api.superlinked.com/v1
